{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "short_name": "CinePersona",
  "version": "1.0.2",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "douban_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://cinepersona.com/*",
    "https://test.gawyn.de/*",
    "http://localhost:3000/*",
    "http://localhost:8081/*",
    "*://*.douban.com/*",
    "*://*.doubanio.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.qq.com/*",
        "*://*.iqiyi.com/*",
        "*://*.youku.com/*",
        "*://*.mgtv.com/*",
        "*://*.alipan.com/*",
        "*://*.aliyundrive.com/*",
        "*://*.quark.cn/*",
        "*://*.baidu.com/*",
        "*://*.115.com/*",
        "*://*.115vod.com/*",
        "*://*.anxia.com/*",
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.disneyplus.com/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://tv.apple.com/*"
      ],
      "all_frames": true,
      "js": [
        "i18n.js",
        "content/cleaner.js",
        "content/parsers.js",
        "content/scrobbler.js",
        "content/ui-toast.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
